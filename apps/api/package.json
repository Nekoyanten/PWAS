{
  "name": "paws-campaign-api",
  "version": "0.1.0",
  "description": "PAWS Campaign Platform — backend + dashboard (Objetivos 1-4)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:init": "psql \"$DATABASE_URL\" -f ../../db/schema.sql",
    "db:migrate": "psql \"$DATABASE_URL\" -f ../../db/migrations/001_taskflow_decoy.sql",
    "seed:demo": "node scripts/seed_demo.js",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "nanoid": "^5.0.7",
    "onnxruntime-node": "1.29.0",
    "pg": "^8.12.0"
  },
  "engines": {
    "node": ">=18"
  }
}
