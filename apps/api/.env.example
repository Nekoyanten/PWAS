# Copiar a .env y ajustar. Nunca commitear el .env real.
DATABASE_URL=postgres://paws:paws_local_dev@localhost:5432/paws_campaign
PORT=3000
# Token compartido simple para proteger las rutas /api/* de administración.
# Suficiente para un piloto de laboratorio cerrado; para producción real
# reemplazar por autenticación de usuarios (ver README, sección "Siguientes pasos").
ADMIN_API_KEY=cambia_esta_clave_antes_de_ejecutar
